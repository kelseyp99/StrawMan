rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Elections/{document=**} {
      allow read, write: if true;
    }
    // Allow authenticated users to read/write their own user doc (lowercase)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Allow authenticated users to read/write their own Elections subcollection (uppercase)
    match /Users/{userId}/Elections/{electionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /Candidates/{document=**} {
      allow read, write: if true;
    }
    // Open access for testing
    match /Discussion/{document=**} {
      allow read, write: if true;
    }
    match /Users/{uid}/Discussion/{document=**} {
      allow read, write: if true;
    }
    match /ActivityLog/{document=**} {
      allow read, write: if true;
    }
    match /Categories/{document=**} {
      allow read, write: if true;
    }
    // Legacy: users/{userId} for older app
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null && request.auth.uid == userId && 
        (resource.data.appId == "com.anonymous.LifeLog7" || resource.data.appVersion < "1.1.0");
    }
    // Current: Users/{uid} for newer app
    match /Users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /Users/{uid}/Votes/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /Users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Root-level Discussion for older app
    match /Discussion/{document} {
  allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.uid == null || // Allow updates to legacy documents
        resource.data.uid == request.auth.uid
      ) && request.resource.data.uid == request.auth.uid;
    }
    // User-specific Discussion for newer app
    match /Users/{uid}/Discussion/{document} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && 
                    request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && request.auth.uid == uid && 
                            resource.data.uid == request.auth.uid && 
                            request.resource.data.uid == request.auth.uid;
    }    
    match /Users/{uid}/ChangeLog/{changeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /Users/{uid}/SyncEntry/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /GPTResponses/{document} {
      allow read, write: if request.auth != null;
    }
    match /Rules/{ruleId} {
      allow read, write: if request.auth != null;
    }
    match /RuleCandidates/{document} {
      allow read, write: if request.auth != null;
    }
    match /AI_Models/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /Alert/{document} {
      allow read, write: if request.auth != null;
    }
    match /GPTSpecialties/{document} {
      allow read, write: if request.auth != null;
    }
    match /Users/{uid}/Votes/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
