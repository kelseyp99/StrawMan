{
  "expo": {
    "name": "LifeLog",
    "slug": "LifeLog",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/ask-janet-icon.png",
    "scheme": "com.anonymous.lifelog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppTrackingTransparency": true
    },
    "android": {
      "package": "com.anonymous.lifelog",
      "permissions": ["WRITE_EXTERNAL_STORAGE", "READ_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": ["expo-router"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a27bcb78-af2a-4ef8-adeb-7fae3e17731d"
      },
      "googleClientIdAndroid": "341732508688-o2qbbr16g2qh3e8niofee9iv4tl6krhb.apps.googleusercontent.com",
      "react-native-google-mobile-ads": {
        "android_app_id": "ca-app-pub-1315319831980259~1158662288"
      }
    },
    "owner": "kelseyp99",
    "jsEngine": "hermes"
  }
}
