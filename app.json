{
  "expo": {
    "name": "LifeLog",
    "slug": "LifeLog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "src/assets/images/ask-janet-icon.png",
    "scheme": "lifelog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppTrackingTransparency": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.lifelog",
      "compileSdkVersion": 33
    },
    "plugins": [
      "expo-router",
      "expo-dev-client"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a27bcb78-af2a-4ef8-adeb-7fae3e17731d"
      }
    },
    "owner": "kelseyp99",
    "jsEngine": "hermes"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-1315319831980259~1158662288"
  }
}