# 📌 Learn more: https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ✅ Dependencies
node_modules/

# ✅ Expo Files
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ✅ Native Builds & Credentials
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.apk
*.aab

# ✅ Metro Bundler
.metro-health-check*

# ✅ Debugging Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ✅ macOS System Files
.DS_Store
*.pem

# ✅ Local Environment Variables
.env*
.env.local
.env.development
.env.production
.env.test

# ✅ TypeScript Build Info
*.tsbuildinfo

# ✅ Miscellaneous
app-example/
junk/
crash_log.txt
backup_log.txt

# ✅ Realm Files
*.realm
*.realm.lock

# ✅ Ignore all image files
*.png
*.jpg
*.jpeg
*.gif

# ✅ Allow images in assets/images/
!/assets/images/**/*.png
!/assets/images/**/*.jpg
!/assets/images/**/*.jpeg
!/assets/images/**/*.gif

# ✅ Ignore all JavaScript files
*.js

# ✅ Explicitly include necessary JavaScript files
!metro.config.js
!app.config.js

# ✅ Temporary build script
src/utils/scripts/build_and_distribute.sh

# ✅ Other generated files
lifelog-f2904-b5d58f4dfdec.json
*.tflite
*.bin

# ✅ Ensure shell scripts use LF line endings
*.sh text eol=lf

# Ignore override config file
/config-overrides.js

# Ignore junk folder
/junk/

# Ignore these folders in src
/src/assets/
/src/components/
/src/css/
/src/js/
/src/scripts/

# Ignore JS files anywhere in src
/src/**/*.js
