# 📌 Learn more: https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ✅ Dependencies
node_modules/

# ✅ Expo Files
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ✅ Native Builds & Credentials
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.apk

# ✅ Metro Bundler
.metro-health-check*

# ✅ Debugging Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ✅ macOS System Files
.DS_Store
*.pem

# ✅ Local Environment Variables
.env*
.env.local
.env.development
.env.production
.env.test

# ✅ TypeScript Build Info
*.tsbuildinfo


# ✅ Miscellaneous
app-example/
junk/
crash_log.txt

# Exclude APK files
*.apk

# Exclude Realm files
*.realm
*.realm.lock

# Exclude node_modules
node_modules/



# Ignore all JavaScript files
*.js

# Explicitly include the necessary JavaScript files
!metro.config.js
!app.config.js
