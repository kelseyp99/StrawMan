# Ignore jar files
*.jar
# Ignore secrets directory
secrets/
# Ignore environment files
.env
# Ignore APK build artifacts
apk
# Node modules
node_modules/

# Ignore generated Android resource images
android/app/src/main/res/drawable-hdpi/*
android/app/src/main/res/drawable-mdpi/*
android/app/src/main/res/drawable-xhdpi/*
android/app/src/main/res/drawable-xxhdpi/*
android/app/src/main/res/drawable-xxxhdpi/*

# Prevent .webp launcher icons from being added to the repo
android/app/src/main/res/mipmap-*/ic_launcher*.webp


# Logs
logs.txt
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
build/
*.apk
*.aab
*.tar.gz

# Expo
.expo/
.expo-shared/

# Metro
.cache/

# macOS
.DS_Store

# Android
android/app/build/
android/.gradle/
android/local.properties
android/.idea/

# iOS (track project, ignore build artifacts and dependencies)
ios/Pods/
ios/build/
ios/**/xcuserdata/
*.xcuserstate
ios_broken_*/

# Environment
.env
.env.*

# VSCode
.vscode/

# Misc
*.keystore
*.jks

# Backup folders
*-backup/
ios_broken_*/

# Coverage
coverage/

# TypeScript
*.tsbuildinfo

# Others
*.swp
*.swo

# Firebase local cache (keep firebase.json & .firebaserc)
.firebase/

# Ignore backup config
app.json.bak

# Ignore SmartCities workspace
SmartCities.code-workspace

# Google OAuth secrets
client_secret*.json
client_*.plist
