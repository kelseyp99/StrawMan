{
  "cli": {
    "version": ">= 15.0.10",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,  
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "production": {
        "developmentClient": false,
        "distribution": "store",
        "android": {
          "buildType": "apk"
        },
        "env": {
          "EXPO_PUBLIC_IS_EXPO_GO": "false"
        }
      },
      "submit": {
        "production": {}
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_GIT_BRANCH": "main"
      },
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "beta": {
      "distribution": "store",
      "channel": "beta",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {},
    "beta": {
      "android": {
        "track": "beta"
      }
    }
  }
}